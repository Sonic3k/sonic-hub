# Serves the built web on $PORT (Railway sets it). Hashed assets are cached for a year; every other path is the app
# itself (index.html), never cached, so a new deploy shows at once and the installed app's service worker updates.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	@app not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @app Cache-Control "no-cache"
	header X-Content-Type-Options nosniff
	# the API is its own service: the web calls it at VITE_API_URL
	handle /api/* {
		respond "The learn API runs on its own address (VITE_API_URL)." 404
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
