# API
# Either a ready connection string (local development)…
DATABASE_URL=postgresql://learn@localhost:5432/learn
# …or, on Railway, the shared Postgres server's superuser URL plus a password for the learn role:
# the API then creates role learn_app and database learn there on first start (like Huyền học does).
# DATABASE_ADMIN_URL=${{Postgres.DATABASE_URL}}
# LEARN_DB_PASSWORD=
# LEARN_DB_NAME=learn
# LEARN_DB_USER=learn_app
# DATABASE_SSL=no-verify            # TLS without certificate check (Railway Postgres)
PORT=3100
CORS_ORIGIN=*
APP_TIMEZONE=Asia/Ho_Chi_Minh
DAY_ROLLOVER_HOUR=4
MEDIA_BASE_URL=https://sonic-hub.b-cdn.net

# Local development: sync media into ../.media and let the API serve it
# MEDIA_BASE_URL=http://localhost:3100/media
# MEDIA_SERVE_DIR=../.media

# Content sync (local; on Railway it runs as the API's pre-deploy command, see deploy/api.Dockerfile)
# MEDIA_STORAGE=b2                  # b2 | local | none (default: b2 when B2_KEY_ID is set)
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=sonic-hub
# B2_ENDPOINT=s3.us-east-005.backblazeb2.com
# B2_REGION=us-east-005
