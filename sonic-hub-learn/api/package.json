{
  "name": "@learn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@learn/shared": "*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  }
}
